{
  "mcpServers": {
    "graphify": {
      "command": "/absolute/path/to/graphify/python",
      "args": ["-m", "graphify.serve", "/absolute/path/to/swift-ticket/graphify-out/graph.json"]
    },
    "@21st-dev/magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${TWENTYFIRST_API_KEY}"
      }
    },
    "nano-banana-2": {
      "command": "npx",
      "args": ["-y", "nano-banana-2-mcp"],
      "env": {
        "GEMINI_API_KEY": "${NANO_BANANA_GEMINI_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
